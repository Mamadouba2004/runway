# Plaid — https://dashboard.plaid.com/developers/keys (free Trial plan, 10 connections)
PLAID_CLIENT_ID=
# "sandbox" for fake test data, "production" for real Chase data (uses one of
# the 10 free trial connections). Pick which secret to load based on this.
PLAID_ENV=sandbox
PLAID_SANDBOX_SECRET=
PLAID_PRODUCTION_SECRET=

# Where OAuth banks (Chase, Wells Fargo, …) send the user back to. Must be
# registered under Allowed redirect URIs at https://dashboard.plaid.com/developers/api
# No query params. Sandbox permits http://localhost; Production requires https.
# Leave blank to skip OAuth support (plain-credential institutions still work).
PLAID_REDIRECT_URI=http://localhost:3000/oauth

# Single-user auth gate. The app has no user table — this one passphrase
# protects every route. AUTH_SECRET signs the session cookie; generate with
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Both are REQUIRED: with AUTH_SECRET unset the app fails closed (503).
AUTH_PASSWORD=
AUTH_SECRET=

# AES-256-GCM key encrypting Plaid access tokens at rest, so a leaked
# DATABASE_URL yields ciphertext rather than usable bank credentials.
# 32 bytes of hex (64 characters). REQUIRED — the app refuses to read or write
# an access token without it rather than silently falling back to plaintext.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating it requires re-encrypting existing rows; there is no dual-key read.
TOKEN_ENCRYPTION_KEY=

# Postgres connection string (Neon or Supabase, free tier)
# e.g. postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=
