# Teller.io — https://teller.io/dashboard (free tier)
TELLER_APPLICATION_ID=
# Contents of the Teller client certificate (PEM). For local dev you may instead
# point at a file path and read it in lib/teller/client.ts.
TELLER_CERTIFICATE=
# Contents of the Teller private key (PEM). Never commit the real value.
TELLER_PRIVATE_KEY=

# Postgres connection string (Neon or Supabase, free tier)
# e.g. postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=
